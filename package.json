{
  "name": "@aklinker1/logger",
  "version": "1.0.4",
  "description": "Personalized logger for backends",
  "keywords": [
    "logger"
  ],
  "license": "ISC",
  "author": {
    "name": "Aaron Klinker",
    "email": "aaronklinker1@gmail.com"
  },
  "repository": {
    "url": "https://github.com/aklinker1/logger"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "check": "check",
    "dev": "bun run dev.ts",
    "build": "tsdown index.ts --dts.tsgo",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepare": "./node_modules/.bin/simple-git-hooks",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@aklinker1/check": "^2.4.0",
    "@types/bun": "^1.3.13",
    "@typescript/native-preview": "^7.0.0-dev.20260427.1",
    "cspell": "^10.0.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "publint": "^0.3.18",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.21.10"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*": "oxfmt --write"
  },
  "packageManager": "bun@1.3.13"
}
